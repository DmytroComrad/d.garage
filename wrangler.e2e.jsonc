// Конфігурація для e2e-тестів: окрема локальна база й вищі ліміти запитів.
{
  "name": "garage-e2e",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/c/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "garage-e2e", "database_id": "00000000-0000-0000-0000-00000000e2e0", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "garage-media-e2e" }],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "9101", "simple": { "limit": 100000, "period": 60 } },
    { "name": "RL_API", "namespace_id": "9102", "simple": { "limit": 100000, "period": 60 } }
  ],
  // FX_TEST_RATES — сталі курси замість НБУ: тести не ходять в інтернет. Діє лише на localhost.
  "vars": { "APP_URL": "http://localhost:5199", "FX_TEST_RATES": "{\"USD\":41.5,\"EUR\":48.25}" }
}
