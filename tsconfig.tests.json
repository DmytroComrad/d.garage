{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "tests/unit",
    "tests/e2e",
    "shared",
    "src/lib",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
