{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": true,
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests-worker.tsbuildinfo",
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "tests/worker",
    "worker",
    "shared"
  ]
}
