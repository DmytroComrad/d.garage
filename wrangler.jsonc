{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garage",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker першим бачить усе, крім файлів збірки: так сторінки відкриваються лише по HTTPS.
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "garage",
      "database_id": "d771c8b0-c03a-4f0a-9915-045d078023d3",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2001", "simple": { "limit": 15, "period": 60 } },
    { "name": "RL_API", "namespace_id": "2002", "simple": { "limit": 300, "period": 60 } }
  ],
  "vars": {
    "APP_URL": "https://garage.dvoted.club",
    // Публічний ключ віджета: він і так видимий у браузері. Секретний лежить у секретах Worker.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFtc_YQueajttTxs"
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "routes": [{ "pattern": "garage.dvoted.club", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
