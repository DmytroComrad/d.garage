// Конфігурація лише для тестів Worker: без статики, домену й cron.
{
  "name": "garage-test",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "garage-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "9001", "simple": { "limit": 100000, "period": 60 } },
    { "name": "RL_API", "namespace_id": "9002", "simple": { "limit": 100000, "period": 60 } }
  ],
  "vars": { "APP_URL": "http://localhost" }
}
